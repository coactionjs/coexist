{
  "name": "@coexist/react",
  "version": "0.2.1",
  "description": "React adapter for Coexist.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coactionjs/coexist.git",
    "directory": "packages/react"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf coverage dist .turbo",
    "dev": "tsdown --watch",
    "test": "cd ../.. && vitest run --project @coexist/react",
    "test:coverage": "cd ../.. && vitest run --coverage --project @coexist/react",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@coexist/core": "workspace:*",
    "@coexist/tsconfig": "workspace:*",
    "@types/react": "catalog:",
    "@types/react-test-renderer": "catalog:",
    "react": "catalog:",
    "react-test-renderer": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@coexist/core": "workspace:^",
    "react": "^18.3.0 || ^19.0.0"
  }
}
