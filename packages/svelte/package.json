{
  "name": "@coexist/svelte",
  "version": "0.2.1",
  "description": "Svelte adapter for Coexist.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/coactionjs/coexist.git",
    "directory": "packages/svelte"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runes": {
      "types": "./dist/runes.d.ts",
      "import": "./dist/runes.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "clean": "rm -rf coverage dist .turbo",
    "dev": "tsdown --watch",
    "test": "cd ../.. && vitest run --project @coexist/svelte",
    "test:coverage": "cd ../.. && vitest run --coverage --project @coexist/svelte",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@coexist/core": "workspace:*",
    "@coexist/tsconfig": "workspace:*",
    "svelte": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@coexist/core": "workspace:^",
    "svelte": "^4.0.0 || ^5.0.0"
  }
}
